{
  "name": "labmate",
  "productName": "LabMate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Mac-first electronic lab notebook frontend skeleton",
  "author": "Louis Hess",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "package:mac": "npm run build && node scripts/package.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:appearance": "node --experimental-strip-types scripts/check-appearance.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.3.0",
    "playwright": "^1.58.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.2"
  }
}
