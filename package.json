{
  "name": "labmate",
  "productName": "LabMate",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A Mac-first local electronic lab notebook with encrypted backups",
  "author": "Louis Hess",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/check-desktop.mjs && vite build",
    "package:mac": "npm run build && node scripts/package.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:appearance": "node --experimental-strip-types scripts/check-appearance.mjs",
    "rebuild:native": "electron-rebuild --force --only better-sqlite3",
    "test:backend": "node --test tests/*.test.cjs",
    "check:functional": "node scripts/check-functional.mjs",
    "check:dependencies": "node scripts/dependency-inventory.mjs",
    "setup:desktop": "node node_modules/electron/install.js && npm run rebuild:native"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "lucide-react": "^0.577.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "4.2.0",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^25.0.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.3.0",
    "playwright": "^1.58.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
